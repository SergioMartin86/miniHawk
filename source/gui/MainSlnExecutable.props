<Project>
	<Import Project="MainSlnCommon.props" />
	<PropertyGroup>
		<AccelerateBuildsInVisualStudio>false</AccelerateBuildsInVisualStudio>
		<AssemblyTitle>$(Description)</AssemblyTitle>
		<!-- Output path will contain the executable along with all its dependencies. We copy the executable up one directory up later on.
			This allows us to have the executable dependencies automagically copied over to our dll folder while still keeping the executable in the output folder. -->
		<OutputPath>$(MSBuildProjectDirectory)/../../../build/dll/</OutputPath>
		<Product>Chimera</Product>
		<ExecFilesDest>$(MSBuildProjectDirectory)/../../../build/</ExecFilesDest>
		<!-- Setting TargetFileName does not change the AssemblyName (as setting TargetName would), but also does not change the output file name
			for the executable on build (as one would expect). So we still need to rename the executable file below. Using this method has the advantage
			of IDEs respecting the TargetFileName and expecting it. -->
		<TargetFileName>$(Product).exe</TargetFileName>
		<!-- This also doesn't actually change where the executable is output, rather it's just a hint to the IDE to know where the executable is (since we move it). -->
		<TargetPath>$(ExecFilesDest)$(TargetFileName)</TargetPath>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<OutputType>Exe</OutputType>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<OutputType>WinExe</OutputType>
	</PropertyGroup>
	<!-- Native dependencies are built from source (extern/) as part of the main build;
		no prebuilt binaries are committed for libraries that have an in-repo recipe.
		The script is incremental: it skips libraries whose output is newer than their
		sources. -->
	<!-- Windows dev convenience only: the canonical build is Linux-hosted meson
		(see meson.build at the repo root), which builds natives for both targets.
		This hook keeps a plain Windows `dotnet build` self-sufficient. -->
	<Target Name="BuildNativeDeps" AfterTargets="PostBuildEvent" Condition=" '$(OS)' == 'Windows_NT' ">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)../../extern/build-natives.ps1&quot; -OutDir &quot;$(OutputPath)&quot;" />
	</Target>
	<!-- Drop the settings source generator (built via a ReferenceOutputAssembly=false
		ProjectReference) beside the contract DLLs: core packages built out-of-solution
		against build/dll reference it as an analyzer. -->
	<Target Name="ProvideCoreAuthorKit" AfterTargets="PostBuildEvent">
		<Copy SourceFiles="$(MSBuildThisFileDirectory)../../extern/Chimera.SrcGen.SettingsUtil/bin/$(Configuration)/netstandard2.0/Chimera.SrcGen.SettingsUtil.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
	</Target>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<ItemGroup>
			<EmptyDirsToCreate Include="$(ExecFilesDest)ExternalTools;$(ExecFilesDest)Firmware;$(ExecFilesDest)Tools" />
			<ExecFilesFromExecProj Include="$(OutputPath)$(MSBuildProjectName).*" /> <!-- doesn't include the .exe.config because those are automatically renamed??? -->
			<ExecConfigFilesFromExecProj Include="$(OutputPath)$(TargetFileName).*" /> <!-- include the .exe.config files -->
		</ItemGroup>
		<!-- Surely this can be done in one step, right? FIXME -->
		<Move SourceFiles="@(ExecFilesFromExecProj)" DestinationFiles="@(ExecFilesFromExecProj->Replace('$(MSBuildProjectName)', '$(Product)'))" />
		<Move SourceFiles="@(ExecFilesFromExecProj->Replace('$(MSBuildProjectName)', '$(Product)'))" DestinationFolder="$(ExecFilesDest)" />
		<Move SourceFiles="@(ExecConfigFilesFromExecProj)" DestinationFolder="$(ExecFilesDest)" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)/ChimeraMono.sh" DestinationFolder="$(ExecFilesDest)" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)/ChimeraMono.sh')" />
		<MakeDir Directories="@(EmptyDirsToCreate)" />
		<Touch Files="@(EmptyDirsToCreate->Combine('.keep'))" AlwaysCreate="true" />
	</Target>
</Project>
